# 服务端口
PORT=3000

# JWT 密钥（生产环境务必修改）
# 必须替换为随机强值，不可使用此占位符
JWT_SECRET=changeme-please-generate-a-random-strong-secret-of-at-least-32-bytes

# AI 配置：供应商、模型、角色均在管理后台「AI 配置」页面维护，不再使用环境变量

# 管理员默认密码（仅种子初始化用）
# 必须替换为随机强值，不可使用此占位符
ADMIN_DEFAULT_PASSWORD=changeme-generate-a-strong-password

# 前端来源（CORS）
CLIENT_ORIGIN=http://localhost:8080

# 游戏配置
MATCH_TIMEOUT_SEC=30
TURN_TIMER_SEC=15
MAX_ROUNDS=10
BOT_THINK_MIN_MS=3000
BOT_THINK_MAX_MS=6000
