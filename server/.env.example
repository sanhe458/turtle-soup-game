# 服务端口
PORT=3000

# JWT 密钥（生产环境务必修改）
JWT_SECRET=turtle-soup-dev-secret-change-me

# Zhipu GLM API 配置
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# 管理员默认密码（仅种子初始化用）
ADMIN_DEFAULT_PASSWORD=admin123

# 前端来源（CORS）
CLIENT_ORIGIN=http://localhost:8080

# 游戏配置
MATCH_TIMEOUT_SEC=30
TURN_TIMER_SEC=15
MAX_ROUNDS=10
BOT_THINK_MIN_MS=3000
BOT_THINK_MAX_MS=6000
