# 服务端口
PORT=3000

# JWT 密钥（生产环境务必修改）
# 必须替换为随机强值，不可使用此占位符
JWT_SECRET=changeme-please-generate-a-random-strong-secret-of-at-least-32-bytes

# AI 配置：供应商、模型、角色均在管理后台「AI 配置」页面维护，不再使用环境变量

# 管理员默认密码（仅种子初始化用）
# 必须替换为随机强值，不可使用此占位符
ADMIN_DEFAULT_PASSWORD=changeme-generate-a-strong-password

# 前端来源（CORS）
CLIENT_ORIGIN=http://localhost:8080

# 游戏配置
MATCH_TIMEOUT_SEC=30
TURN_TIMER_SEC=15
MAX_ROUNDS=10
BOT_THINK_MIN_MS=3000
BOT_THINK_MAX_MS=6000

# MySQL 5.7 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=turtle
DB_PASSWORD=changeme-generate-a-strong-password
DB_DATABASE=turtle_soup
DB_CONNECTION_LIMIT=10

# Redis 缓存（可选；未配置或不可用时自动降级直查 DB）
# 推荐用 URL：REDIS_URL=redis://[:password@]host:port/db
REDIS_URL=
# 或使用以下分项配置（与 REDIS_URL 二选一）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ts:
